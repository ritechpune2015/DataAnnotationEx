@model Emp
<!DOCTYPE html>
    <html>
    <head>
        <title></title>
    <script src="~/jquery/jquery.js"></script>
    <script src="~/jquery-validate/jquery.validate.js"></script>
    <script src="~/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    
    
    </head>
    <body>
      <h2> New Emp Form </h2>
      <form action="Create" method="Post">
          <div asp-validation-summary="ModelOnly">
          </div>
          <div>
            <label asp-for="EmpName"></label>
            <div>
                <input asp-for="EmpName" />
                <span asp-validation-for="EmpName"></span>
            </div>
          </div>
        <div>
            <label asp-for="Address"></label>
            <div>
                <textarea asp-for="Address"></textarea>
                <span asp-validation-for="Address"></span>
            </div>
        </div>
        <div>
            <label asp-for="EmailID"></label>
            <div>
                <input asp-for="EmailID" />
                <span asp-validation-for="EmailID"></span>
            </div>
        </div>

        <div>
            <label asp-for="MobileNo"></label>
            <div>
                <input asp-for="MobileNo" />
                <span asp-validation-for="MobileNo"></span>
            </div>
        </div>
        <div>
            <label asp-for="Salary"></label>
            <div>
                <input asp-for="Salary" />
                <span asp-validation-for="Salary"></span>
            </div>
        </div>

        <div>
            <label asp-for="Password"></label>
            <div>
                <input asp-for="Password" />
                <span asp-validation-for="Password"></span>
            </div>
        </div>
        <div>
            <label asp-for="ConfirmPassword"></label>
            <div>
                <input asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <input type="submit" value="Save" />

      </form>
    </body>
    </html>